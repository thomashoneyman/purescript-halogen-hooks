{
  "name": "halogen-hooks",
  "private": true,
  "version": "0.0.1",
  "description": "Hooks for Halogen",
  "repository": "https://github.com/thomashoneyman/purescript-halogen-hooks",
  "author": "Thomas Honeyman <hello@thomashoneyman.com>",
  "license": "MIT",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "spago build -p halogen-hooks --pedantic-packages",
    "build:examples": "spago build -p halogen-hooks-examples --pedantic-packages",
    "build:test": "spago build -p halogen-hooks --pedantic-packages",
    "snapshot": "npm run bundle:performance && node test/run-snapshot.mjs",
    "test": "spago test -p halogen-hooks --pedantic-packages",
    "test:performance": "npm run bundle:performance && node test/run-test.mjs",
    "bundle:examples": "spago bundle -p halogen-hooks-examples --minify --module Example.Main --outfile app.js --platform browser --bundle-type app",
    "bundle:performance": "spago build -p halogen-hooks && purs-backend-es build && purs-backend-es bundle-app --no-build --minify --main Performance.Test.App --to test/test.js"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "puppeteer": "25.13.0",
    "purescript": "0.15.16",
    "purs-backend-es": "1.4.3",
    "purs-tidy": "0.11.1",
    "spago": "1.0.4"
  }
}
